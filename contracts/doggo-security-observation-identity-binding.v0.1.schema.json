{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:doggo:contract:DOGGOSecurityObservationIdentityBinding:v0.1",
  "title": "DOGGOSecurityObservationIdentityBinding/v0.1",
  "description": "Binds one DOGGO observation content reference to the Corpus content identity profile and the complete-observation projection. Identity metadata only; not authority, effect, handoff, admission, canonicality, migration, or legacy equivalence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "identity_profile",
    "identity_projection",
    "content_ref"
  ],
  "properties": {
    "schema": {
      "const": "DOGGOSecurityObservationIdentityBinding/v0.1"
    },
    "identity_profile": {
      "const": "CorpusContentIdentityProfile/v0.1"
    },
    "identity_projection": {
      "const": "FULL_DOGGO_SECURITY_OBSERVATION_V0_1"
    },
    "content_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "ref"
      ],
      "properties": {
        "type": {
          "const": "DOGGOSecurityObservation/v0.1"
        },
        "ref": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
